# Copiar a frontend/.env.local (no se versiona) y ajustar.

VITE_API_URL=http://localhost:8080/geotravel/api
VITE_GEOSERVER_WMS_URL=http://localhost:8082/geoserver/geotravel/wms

# Región que muestra el mapa al abrir: salto (defensa) | montevideo. Ver src/components/region.js
VITE_REGION=salto
# Carga a demanda: desde qué zoom se cargan objetos editables y cuántos como máximo por pedido
VITE_ZOOM_MINIMO_EDICION=13
VITE_LIMITE_POR_PANTALLA=500
