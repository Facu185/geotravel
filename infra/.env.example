# Copiar a infra/.env (no se versiona) y ajustar si hace falta.

POSTGRES_DB=geotravel
POSTGRES_USER=geotravel
POSTGRES_PASSWORD=geotravel
POSTGRES_PORT=5432

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_PORT=8082

# Servicio publico de OSRM; requiere internet para calcular rutas.
# Para usar OSRM propio, cambiar esta direccion.
OSRM_URL=https://router.project-osrm.org
# OSRM propio para el criterio "ruta mas corta" (ver infra/osrm/preparar.ps1 y docs/RECURSOS_CERCANOS_RUTAS.md).
# Vacio = criterio desactivado. Con el profile osrm: OSRM_URL=http://osrm-rapida:5000 y OSRM_URL_CORTA=http://osrm-corta:5000
OSRM_URL_CORTA=

# Localidad usada por el servicio de direcciones de la IDE (independiente de VITE_REGION).
# En Salto se usa ademas la tabla local de puertas y calles, que solo cubre esa ciudad.
IDE_DEPARTAMENTO=salto
IDE_LOCALIDAD=salto

# Login del administrador de prueba (cambiar la clave fuera de desarrollo)
ADMIN_USUARIO=admin
ADMIN_CLAVE=urbansafe
