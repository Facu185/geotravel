              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"PAT-99\",\n  \"nombre\": \"Patrulla 99\",\n  \"tipo\": \"patrulla\",\n  \"estadoOperativo\": \"En servicio\",\n  \"descripcion\": \"Recurso de prueba (Postman)\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Point\\\", \\\"coordinates\\\": [-56.1925, -34.906]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear recurso con estado inválido (debe dar 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/recursos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"PAT-99\",\n  \"nombre\": \"Patrulla 99\",\n  \"tipo\": \"patrulla\",\n  \"estadoOperativo\": \"Roto\",\n  \"descripcion\": \"Recurso de prueba (Postman)\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Point\\\", \\\"coordinates\\\": [-56.1925, -34.906]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Estados válidos: Disponible, En servicio, Fuera de servicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar recurso",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base}}/recursos/{{nuevoRecursoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Incidentes (ABM + estados + historial)",
      "item": [
        {
          "name": "Listar incidentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/incidentes"
          }
        },
        {
          "name": "Crear incidente (nace 'Registrado')",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/incidentes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Prueba Postman\",\n  \"descripcion\": \"Incidente de prueba (Postman)\",\n  \"tipoIncidente\": \"incendio\",\n  \"prioridad\": 2,\n  \"equipoResponsable\": \"Equipo Centro\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Point\\\", \\\"coordinates\\\": [-56.193, -34.9065]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta correcta (201)\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"nuevoIncidenteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar incidente (no cambia el estado)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Prueba Postman EDITADA\",\n  \"descripcion\": \"Incidente de prueba (Postman)\",\n  \"tipoIncidente\": \"incendio\",\n  \"prioridad\": 1,\n  \"equipoResponsable\": \"Equipo Centro\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Point\\\", \\\"coordinates\\\": [-56.193, -34.9065]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar un recurso al incidente (necesita nuevoRecursoId: crear el recurso antes)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/recursos/{{nuevoRecursoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recursos asignados al incidente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/recursos"
          }
        },
        {
          "name": "Avanzar a 'En atención'",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/avanzar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"En atención\",\n  \"usuario\": \"gonzalo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Avanzar a 'Registrado' (transición inválida, debe dar 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/avanzar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Registrado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Avanzar a 'Resuelto'",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/avanzar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Resuelto\",\n  \"usuario\": \"gonzalo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Transiciones: Registrado → En atención | Derivado | Cancelado; En atención → Resuelto | Derivado | Cancelado; Derivado → En atención | Cancelado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial de estados (estado, fecha y usuario)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/historial"
          }
        },
        {
          "name": "Quitar la asignación del recurso",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}/recursos/{{nuevoRecursoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar incidente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base}}/incidentes/{{nuevoIncidenteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Consultas geográficas (calculadas por PostGIS)",
      "item": [
        {
          "name": "C1. Incidentes por zona",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/incidentes-por-zona/{{zonaId}}"
          }
        },
        {
          "name": "C2. Zonas con más incidentes (todo el período)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/zonas-mas-incidentes"
          }
        },
        {
          "name": "C2b. Zonas con más incidentes (rango de fechas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/zonas-mas-incidentes?desde=2026-01-01&hasta=2027-01-01"
          }
        },
        {
          "name": "C3. Recursos cercanos a un incidente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/recursos-cercanos/{{incidenteId}}?limite=3"
          }
        },
        {
          "name": "C3b. Recursos cercanos, solo los disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/recursos-cercanos/{{incidenteId}}?limite=3&soloDisponibles=true"
          }
        },
        {
          "name": "C4. Búsqueda de incidente: el más cercano a un punto (x,y en EPSG:32721)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/incidente-mas-cercano?x={{x}}&y={{y}}"
          }
        },
        {
          "name": "C4b. Búsqueda de incidente: el más cercano a un punto (lon,lat: lo que da un clic en el mapa)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/incidente-mas-cercano?lon={{lon}}&lat={{lat}}"
          }
        },
        {
          "name": "C5. Búsqueda de zona: zona que contiene un punto (x,y en EPSG:32721)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/zona-por-punto?x={{x}}&y={{y}}"
          }
        },
        {
          "name": "C5b. Búsqueda de zona: zona que contiene un punto (lon,lat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/zona-por-punto?lon={{lon}}&lat={{lat}}"
          }
        },
        {
          "name": "C5c. Zona de un punto sin coordenada (debe dar 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/zona-por-punto"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "C6. Recursos por zona",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/recursos-por-zona/{{zonaId}}"
          }
        },
        {
          "name": "C7. Incidentes por recurso",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/incidentes-por-recurso/{{recursoId}}"
