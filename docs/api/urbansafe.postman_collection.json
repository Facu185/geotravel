        },
        {
          "name": "Reporte. Incidentes por zona (sin filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/reportes/incidentes-por-zona"
          }
        },
        {
          "name": "Reporte b. Con filtros (zona, tipo, prioridad, estado, fechas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/consultas/reportes/incidentes-por-zona?zonaId={{zonaId}}&tipo=incendio&prioridad=1&estado=Registrado&desde=2026-01-01&hasta=2027-01-01"
          }
        },
