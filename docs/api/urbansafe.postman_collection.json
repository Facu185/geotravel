{
  "info": {
    "name": "UrbanSafe - API y GeoServer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Orden sugerido: 1) Zonas, 2) Recursos (crear antes de asignar), 3) Incidentes, 4) Consultas, 5) GeoServer. Los 'Crear' guardan el id en una variable que usan los siguientes."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080/geotravel/api"
    },
    {
      "key": "geoserver",
      "value": "http://localhost:8082/geoserver/geotravel"
    },
    {
      "key": "zonaId",
      "value": "1"
    },
    {
      "key": "incidenteId",
      "value": "1"
    },
    {
      "key": "recursoId",
      "value": "1"
    },
    {
      "key": "x",
      "value": "572993.6"
    },
    {
      "key": "y",
      "value": "6137023.3"
    },
    {
      "key": "lon",
      "value": "-56.2034"
    },
    {
      "key": "lat",
      "value": "-34.9069"
    },
    {
      "key": "nuevaZonaId",
      "value": ""
    },
    {
      "key": "nuevoRecursoId",
      "value": ""
    },
    {
      "key": "nuevoIncidenteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Zonas operativas (ABM)",
      "item": [
        {
          "name": "Listar zonas (geom en GeoJSON lon/lat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/zonas"
          }
        },
        {
          "name": "Crear zona (valida polígono y no-superposición)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/zonas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ZONA PRUEBA\",\n  \"descripcion\": \"Zona de prueba (Postman)\",\n  \"nivelPrioridad\": 2,\n  \"responsable\": \"Equipo Prueba\",\n  \"observaciones\": \"\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Polygon\\\", \\\"coordinates\\\": [[[-56.205, -34.865], [-56.195, -34.865], [-56.195, -34.858], [-56.205, -34.858], [-56.205, -34.865]]]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda el id en la variable nuevaZonaId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta correcta (201)\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"nuevaZonaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar zona",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/zonas/{{nuevaZonaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ZONA PRUEBA EDITADA\",\n  \"descripcion\": \"Zona de prueba (Postman)\",\n  \"nivelPrioridad\": 3,\n  \"responsable\": \"Equipo Prueba\",\n  \"observaciones\": \"\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Polygon\\\", \\\"coordinates\\\": [[[-56.206, -34.866], [-56.194, -34.866], [-56.194, -34.857], [-56.206, -34.857], [-56.206, -34.866]]]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear zona que se superpone con Centro (debe dar 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/zonas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"CHOCA CON CENTRO\",\n  \"descripcion\": \"Zona de prueba (Postman)\",\n  \"nivelPrioridad\": 2,\n  \"responsable\": \"Equipo Prueba\",\n  \"observaciones\": \"\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Polygon\\\", \\\"coordinates\\\": [[[-56.21, -34.91], [-56.205, -34.91], [-56.205, -34.906], [-56.21, -34.906], [-56.21, -34.91]]]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar zona",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base}}/zonas/{{nuevaZonaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Recursos (ABM)",
      "item": [
        {
          "name": "Listar recursos",
          "request": {
            "method": "GET",
            "header": [],
