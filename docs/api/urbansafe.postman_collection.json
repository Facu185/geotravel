              "raw": "{\n  \"identificacion\": \"PAT-99\",\n  \"nombre\": \"Patrulla 99\",\n  \"tipo\": \"patrulla\",\n  \"estadoOperativo\": \"Disponible\",\n  \"descripcion\": \"Recurso de prueba (Postman)\",\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"Point\\\", \\\"coordinates\\\": [-56.1925, -34.906]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta correcta (201)\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"nuevoRecursoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar recurso (estado operativo)",
          "request": {
            "method": "PUT",
            "header": [
              {
