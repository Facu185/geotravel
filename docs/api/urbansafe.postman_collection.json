              "mode": "raw",
              "raw": "{\n  \"geomGeoJson\": \"{\\\"type\\\": \\\"LineString\\\", \\\"coordinates\\\": [[-56.206, -34.9072], [-56.199, -34.9066], [-56.19, -34.9057]]}\"\n}",
